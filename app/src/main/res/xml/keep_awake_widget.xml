<?xml version="1.0" encoding="utf-8"?>
<!-- A single 1x1 button; redrawn by the app whenever the state changes, so no periodic updates.
     The API 31+ attributes (preview, cell size) are ignored on older Android -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_toggle"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_toggle"
    android:resizeMode="none"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
