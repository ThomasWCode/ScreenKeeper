<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggle_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/boot_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/start_on_boot"
            android:textSize="16sp" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="24dp"
            android:text="@string/permissions_header"
            android:textSize="18sp" />

        <TextView
            style="@style/Label"
            android:text="@string/overlay_label" />

        <TextView
            android:id="@+id/overlay_status"
            style="@style/Detail" />

        <Button
            android:id="@+id/overlay_button"
            style="@style/ActionButton"
            android:text="@string/grant" />

        <TextView
            style="@style/Label"
            android:text="@string/notification_label" />

        <TextView
            android:id="@+id/notification_status"
            style="@style/Detail" />

        <Button
            android:id="@+id/notification_button"
            style="@style/ActionButton"
            android:text="@string/grant" />

        <TextView
            style="@style/Label"
            android:text="@string/battery_label" />

        <TextView
            android:id="@+id/battery_status"
            style="@style/Detail" />

        <Button
            android:id="@+id/battery_button"
            style="@style/ActionButton"
            android:text="@string/allow" />

        <TextView
            style="@style/Detail"
            android:layout_marginTop="24dp"
            android:text="@string/note" />

    </LinearLayout>
</ScrollView>
